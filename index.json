{
  "indexVersion": 1,
  "name": "lk888 Plugins",
  "plugins": [
    {
      "key": "lk888api",
      "name": "lk888",
      "icon": "text:lk888",
      "website": "https://ai.jiasuapi.com/",
      "description": {
        "en": "lk888 image & video media platform with balance, usage, models & pricing queries. Official site: https://ai.jiasuapi.com/",
        "zh": "lk888中转平台（图片、视频、余额、消费、模型查询与定价）。官方地址：https://ai.jiasuapi.com/"
      },
      "routes": [
        {
          "method": "POST",
          "path": "/lk888api/v1/videos/generations",
          "type": "submit",
          "action": "video",
          "decode": "decodeVideoSubmit",
          "render": "taskCreatedJsapi",
          "models": [
            "sd-2.0-720",
            "sd-2.0-720-fast",
            "sd-2.0-933-720-fast-原生真人",
            "sd-2.0-933-720-满血原生真人",
            "seedance-2.0-900",
            "seedance-2.0-933",
            "seedance-2.5-101010",
            "seedance-2.5-301010",
            "seedance-2.5-900"
          ]
        },
        {
          "method": "POST",
          "path": "/lk888api/v1/images/create",
          "type": "submit",
          "action": "image",
          "decode": "decodeImageSubmit",
          "render": "taskCreatedJsapi",
          "models": [
            "gpt-image-2.5-1k",
            "gpt-image-2.5-sunburst-1k",
            "jimeng-5.0"
          ]
        },
        {
          "method": "GET",
          "path": "/lk888api/v1/videos/tasks/:task_id",
          "type": "query",
          "render": "taskStatusJsapi",
          "taskIdParam": "task_id"
        },
        {
          "method": "GET",
          "path": "/lk888api/v1/images/tasks/:task_id",
          "type": "query",
          "render": "taskStatusJsapi",
          "taskIdParam": "task_id"
        },
        {
          "method": "GET",
          "path": "/lk888api/v1/skills/balance",
          "type": "proxy",
          "upstreamPath": "/v1/skills/balance"
        },
        {
          "method": "GET",
          "path": "/lk888api/v1/skills/usage",
          "type": "proxy",
          "upstreamPath": "/v1/skills/usage"
        },
        {
          "method": "GET",
          "path": "/lk888api/v1/skills/models",
          "type": "proxy",
          "upstreamPath": "/v1/skills/models"
        },
        {
          "method": "GET",
          "path": "/lk888api/v1/skills/models/:model_name",
          "type": "proxy",
          "upstreamPath": "/v1/skills/models/:model_name"
        },
        {
          "method": "GET",
          "path": "/lk888api/v1/skills/models/:model_name/pricing",
          "type": "proxy",
          "upstreamPath": "/v1/skills/models/:model_name/pricing"
        }
      ],
      "protocols": [
        {
          "name": "openai_video",
          "models": [
            "sd-2.0-720",
            "sd-2.0-720-fast",
            "sd-2.0-933-720-fast-原生真人",
            "sd-2.0-933-720-满血原生真人",
            "seedance-2.0-900",
            "seedance-2.0-933",
            "seedance-2.5-101010",
            "seedance-2.5-301010",
            "seedance-2.5-900"
          ]
        }
      ],
      "models": [
        "gpt-image-2.5-1k",
        "gpt-image-2.5-sunburst-1k",
        "jimeng-5.0",
        "sd-2.0-720",
        "sd-2.0-720-fast",
        "sd-2.0-933-720-fast-原生真人",
        "sd-2.0-933-720-满血原生真人",
        "seedance-2.0-900",
        "seedance-2.0-933",
        "seedance-2.5-101010",
        "seedance-2.5-301010",
        "seedance-2.5-900"
      ],
      "latest": "1.0.2",
      "versions": [
